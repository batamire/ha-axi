{
  "compilerOptions": {
  "target": "ES2022",
  "lib": ["ES2024"],
  "module": "Node16",
  "moduleResolution": "Node16",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"]
}
